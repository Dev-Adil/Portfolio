/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://randomuser.me; connect-src 'self' ws: https://api.emailjs.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; upgrade-insecure-requests
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), accelerometer=(), gyroscope=()
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Security headers applied to all routes above
# Route-specific caching rules below

/index.html
  # Don't cache HTML - users must always get latest version
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  # Cache static assets for 1 year (content-hashed filenames ensure cache invalidation)
  Cache-Control: public, max-age=31536000, immutable

/*.js
  # Cache JavaScript files
  Cache-Control: public, max-age=31536000, immutable

/*.css
  # Cache CSS files
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  # Cache fonts
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  # Cache fonts
  Cache-Control: public, max-age=31536000, immutable

/*.gltf
  # Cache 3D models with stale-while-revalidate for better performance
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.bin
  # Cache binary assets
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.png
  # Cache images
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  # Cache images
  Cache-Control: public, max-age=31536000, immutable

/*.jpeg
  # Cache images
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  # Cache SVGs
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  # Cache WebP images
  Cache-Control: public, max-age=31536000, immutable

/*.br
  # Cache Brotli compressed files
  Cache-Control: public, max-age=31536000, immutable

/*.gz
  # Cache Gzip compressed files
  Cache-Control: public, max-age=31536000, immutable
