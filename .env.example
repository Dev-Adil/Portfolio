# EmailJS credentials — used by the contact form (src/components/Contact.tsx).
# Create a free account at https://www.emailjs.com/ and copy this file to `.env`.
#
# Note: Vite inlines VITE_* variables into the client bundle at build time, so these
# values are public by design. The EmailJS *public key* is meant to be exposed; restrict
# abuse by enabling "Allowed Origins" for your service in the EmailJS dashboard.

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
